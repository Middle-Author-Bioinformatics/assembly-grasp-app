# Assembly Grasp frontend — build-time configuration.
#
# These values are read by Vite at `npm run build`. On AWS Amplify, set them
# under App settings → Environment variables instead of committing them.
# Locally, copy this file to `.env.local` to use them during `npm run dev`.

# assembly-grasp Lambda Function URL (see lambda/assembly_grasp.py).
#   POST { "query": "Drosophila melanogaster" }  -> filtered TSV (download)
#   GET  ?query=Drosophila%20melanogaster         -> same, shareable
VITE_AG_API_BASE=https://xxxxxxxx.lambda-url.us-east-2.on.aws

# S3 bucket the Lambda reads the metadata file from. Display only — the Lambda
# already knows which bucket/key to read.
VITE_AG_BUCKET=assembly-grasp-bucket
